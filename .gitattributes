# Git LFS rules adopted from build/gitattributes.proposed (W0-02). One writer per binary asset.
*.uasset filter=lfs diff=lfs merge=lfs -text lockable
*.umap filter=lfs diff=lfs merge=lfs -text lockable
artsource/**/*.blend filter=lfs diff=lfs merge=lfs -text lockable
artsource/**/*.fbx filter=lfs diff=lfs merge=lfs -text lockable
artsource/**/*.psd filter=lfs diff=lfs merge=lfs -text lockable
artsource/**/*.tga filter=lfs diff=lfs merge=lfs -text lockable
artsource/**/*.exr filter=lfs diff=lfs merge=lfs -text lockable
artsource/**/*.png filter=lfs diff=lfs merge=lfs -text lockable
artsource/**/*.tif filter=lfs diff=lfs merge=lfs -text lockable
artsource/**/*.tiff filter=lfs diff=lfs merge=lfs -text lockable
artsource/**/*.wav filter=lfs diff=lfs merge=lfs -text lockable
